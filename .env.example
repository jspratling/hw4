# Copy this file to backend/.env and fill in your own values.
# Never commit the real backend/.env (it is listed in .gitignore).

# Required for the chat assistant: your Portkey API key.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: which AI model to use (default: gpt-6-luna).
# AGENT_MODEL=gpt-6-luna

# Optional: secret used to sign login sessions. If left out, a new random one is made
# each time the backend starts (shoppers then need to log in again after a restart).
# SESSION_SECRET=any-long-random-string

# Optional (Problem 4 password reset): the web address used in reset links.
# SITE_URL=http://localhost:5173

# Optional: SMTP settings so reset links are emailed to the shopper's inbox.
# Without them the email is saved to backend/logs/outbox/ (not committed) instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=Campus Customs <no-reply@example.com>
